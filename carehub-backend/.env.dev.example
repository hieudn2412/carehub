# Shared development services on the VPS. Copy to .env.dev; never commit it.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_PASSWORD=

DB_URL=jdbc:postgresql://116.118.6.153:5432/carehub
DB_USERNAME=
DB_PASSWORD=

RABBITMQ_HOST=116.118.6.153
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false
RABBITMQ_LISTENER_ENABLED=true

MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_USERNAME=api_token
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.example
MAIL_FROM_NAME=VietDuc Care
MAIL_REPLY_TO=support@your-domain.example
MAIL_BRAND_NAME=VietDuc Care
MAIL_WEBSITE_URL=https://your-domain.example
MAIL_SUPPORT_EMAIL=support@your-domain.example

# The shared development database must not be seeded automatically.
APP_SEED_ENABLED=false
APP_SEED_QUESTION_BANK_ENABLED=false
ADMIN_EMPLOYEE_CODE=ADMIN001
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Development Administrator

GENERATION_PROVIDER=api
DEEPSEEK_API_KEY=
EMBEDDING_PROVIDER=lexical
E5_PRELOAD=false
E5_BACKFILL_ON_STARTUP=false
PARAPHRASE_PROVIDER=disabled
VIETQUILL_PRELOAD=false
DOCUMENT_STORAGE_PATH=storage/documents
APP_OCR_ENGINE=none

R2_ENDPOINT=
BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=

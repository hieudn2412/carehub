# Copy to .env.prod on the VPS. Never commit the real file.
APP_DOMAIN=quanlydieuduongvd.org
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://quanlydieuduongvd.org
DEFAULT_PASSWORD=

DB_URL=jdbc:postgresql://db:5432/carehub
DB_USERNAME=carehub
DB_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=carehub
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false
RABBITMQ_LISTENER_ENABLED=true

MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_USERNAME=api_token
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.example
MAIL_FROM_NAME=VietDuc Care
MAIL_REPLY_TO=support@your-domain.example
MAIL_BRAND_NAME=VietDuc Care
MAIL_WEBSITE_URL=https://your-domain.example
MAIL_SUPPORT_EMAIL=support@your-domain.example

# Enable only for the first deployment of a brand-new database. Set to false
# and restart backend immediately after verifying the administrator login.
APP_SEED_ENABLED=true
APP_SEED_QUESTION_BANK_ENABLED=false
ADMIN_EMPLOYEE_CODE=ADMIN001
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

GENERATION_PROVIDER=api
DEEPSEEK_API_KEY=
EMBEDDING_PROVIDER=lexical
E5_PRELOAD=false
E5_BACKFILL_ON_STARTUP=false
PARAPHRASE_PROVIDER=disabled
VIETQUILL_PRELOAD=false
DOCUMENT_STORAGE_PATH=/data/documents
APP_OCR_ENGINE=none

R2_ENDPOINT=
BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=
